# ==========================================
# EPrints Unpublish Viewer - Environment Config
# Perpustakaan Universitas Muhammadiyah Surakarta
# ==========================================

PORT=5000
NODE_ENV=production
DATA_DIR=/app/data
JWT_SECRET=ums-library-unpublish-secret-key-2026
SESSION_SECRET=ums-library-patron-secret-2026
ALLOWED_EMAIL_DOMAIN=ums.ac.id
FRONTEND_URL=http://localhost:3000

# EPrints Database (Read-Only MySQL)
# Set to 'false' if connecting to live campus MySQL server
EPRINTS_USE_MOCK=false
DB_HOST=10.x.x.x
DB_PORT=3306
DB_DATABASE=etd2018
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# EPrints Document Storage Mount Path
EPRINTS_DOCUMENTS_PATH=/eprints/documents

# EPrints HTTP origin and credentials for fetching staffonly / unpublish PDF documents
EPRINTS_BASE_URL=https://10.x.x.x
EPRINTS_HTTP_USER=your_eprints_http_user
EPRINTS_HTTP_PASSWORD=your_eprints_http_password

# CAS SSO Configuration (UMS auth.ums.ac.id)
CAS_HOST=auth.ums.ac.id
CAS_PORT=443
CAS_CONTEXT=/cas
CAS_VERSION=2.0
CAS_DISABLE_SSL_VALIDATION=true
CAS_SERVICE_URL=http://your-domain.ums.ac.id:3000/api/v1/auth/cas/callback

# Google OAuth2 Credentials for Admin Pustakawan (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

