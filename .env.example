# ==========================================
# EPrints Unpublish Viewer - Environment Config
# Perpustakaan Universitas Muhammadiyah Surakarta
# ==========================================

PORT=5000
NODE_ENV=production
DATA_DIR=/app/data
JWT_SECRET=ums-library-unpublish-secret-key-2026
SESSION_SECRET=ums-library-patron-secret-2026
ALLOWED_EMAIL_DOMAIN=ums.ac.id

# EPrints Database (Read-Only MySQL)
# Set to 'false' if connecting to live campus MySQL server
EPRINTS_USE_MOCK=true
EPRINTS_DB_HOST=172.17.0.1
EPRINTS_DB_PORT=3306
EPRINTS_DB_NAME=eprints_ums
EPRINTS_DB_USER=eprint_readonly
EPRINTS_DB_PASSWORD=secret_ro_password

# EPrints Document Storage Mount Path
EPRINTS_DOCUMENTS_PATH=/eprints/documents

# Google OAuth2 Credentials for Admin Pustakawan
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
